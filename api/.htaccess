# Rehohub account API: send every /api/... request to index.php
Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^ index.php [L,QSA]
</IfModule>

# Never serve the settings file, the sample or the library code directly
<FilesMatch "^(config\.php|config\.sample\.php)$">
  Require all denied
</FilesMatch>
